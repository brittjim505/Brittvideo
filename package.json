{
  "name": "brittvideo",
  "private": true,
  "version": "3.0.0-phase3",
  "description": "BrittVideo — production application",
  "workspaces": ["server", "web"],
  "scripts": {
    "build": "npm run build -w web && npm run build -w server",
    "start": "npm run start -w server",
    "dev": "npm run dev -w server",
