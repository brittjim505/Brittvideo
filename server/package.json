{
  "name": "@brittvideo/server",
  "private": true,
  "version": "3.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.mjs",
    "start": "node --env-file=.env dist/index.js",
    "test": "vitest run",
    "migrate": "tsx --env-file=.env src/cli/migrate.ts",
    "create-super-user": "tsx --env-file=.env src/cli/create-super-user.ts",
    "backup": "tsx --env-file=.env src/cli/backup.ts",
    "restore": "tsx --env-file=.env src/cli/restore.ts",
    "import-prototype": "tsx --env-file=.env src/cli/import-prototype.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.5",
    "fastify": "^5.12.5",
    "node-html-parser": "^6.1.13",
    "pg": "^8.23.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
