# BrittVideo environment template — copy to server/.env and fill in. NEVER commit real values.
# Generate keys with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# development | test | live   (each environment must use its OWN database)
APP_ENV=development
PORT=3000
HOST=127.0.0.1
PUBLIC_BASE_URL=http://localhost:3000

# PostgreSQL. Live database name must contain "live" or "prod"; non-live names must not.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/brittvideo_dev

# 32-byte base64 keys. Keep a copy of BACKUP_ENCRYPTION_KEY somewhere safe OFF this computer
# (e.g. a password manager) — without it, backups cannot be restored.
SECRETS_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_A_DIFFERENT_32_BYTE_BASE64_KEY

BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=35
STORAGE_DIR=./storage
SESSION_DAYS=14
DEMO_LINK_DEFAULT_DAYS=14

# Where SEND FOR SUPPORT reports should go (your developer / support contact)
SUPPORT_EMAIL=

# Folder containing pg_dump / pg_restore if they are not on PATH (e.g. /opt/homebrew/opt/postgresql@16/bin)
PG_BIN_DIR=
JOBS_ENABLED=true

# Provider credentials (Square, Vimeo, HeyGen, email/SMS) are NOT set here. The Super User enters them in
# Settings → Integrations, where they are stored encrypted and never shown again.
